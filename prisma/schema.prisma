generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザーロール
enum UserRole {
  ADMIN          // 管理者
  CONTRACTOR     // 発注担当（発注側企業のユーザー）
  SUBCONTRACTOR  // 受注担当（受注側企業のユーザー）
}

// 会社種別
enum CompanyType {
  GENERAL_CONTRACTOR  // 発注企業
  SUBCONTRACTOR       // 受注企業
}

// 案件ステータス
enum ProjectStatus {
  IN_PROGRESS  // 進行中
  COMPLETED    // 完了
  CANCELLED    // 中止
}

// 発注ステータス
enum OrderStatus {
  DRAFT              // 下書き
  PENDING_APPROVAL   // 申請中
  APPROVED           // 承認済
  ORDERED            // 発注済
  ACCEPTED           // 請負済
  DELIVERY_REPORTED  // 納品完了
  INSPECTED          // 検収完了
  REJECTED           // 却下
  CANCELLED          // 取消
}

// 請求ステータス
enum InvoiceStatus {
  DRAFT      // 下書き
  SUBMITTED  // 提出済
  APPROVED   // 承認済
  REJECTED   // 却下
  PAID       // 支払済
}

// 承認フロー対象種別
enum ApprovalTargetType {
  ORDER    // 発注
  INVOICE  // 請求
}

// 承認ステータス
enum ApprovalStatus {
  PENDING   // 保留
  APPROVED  // 承認
  REJECTED  // 却下
}

// 招待ステータス
enum InvitationStatus {
  PENDING    // 招待中（未受諾）
  ACCEPTED   // 受諾済（受注企業として登録完了）
  REVOKED    // 発注企業側で取消
  EXPIRED    // 有効期限切れ
}

// ==============================
// 会社
// ==============================
model Company {
  id                 String      @id @default(cuid())
  name               String      // 会社名
  code               String      @unique // 会社コード
  companyType        CompanyType // 会社種別
  postalCode         String?     // 郵便番号
  address            String?     // 住所
  phone              String?     // 電話番号
  email              String?     // メールアドレス
  registrationNumber String?     // 適格請求書発行事業者登録番号
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  users             User[]
  projects          Project[]
  issuedOrders      PurchaseOrder[] @relation("OrderIssuer")
  receivedOrders    PurchaseOrder[] @relation("OrderReceiver")
  issuedInvoices    Invoice[]       @relation("InvoiceIssuer")
  receivedInvoices  Invoice[]       @relation("InvoiceReceiver")
}

// ==============================
// ユーザー
// ==============================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // bcrypt hashed
  role      UserRole
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdOrders   PurchaseOrder[] @relation("OrderCreatedBy")
  createdInvoices Invoice[]       @relation("InvoiceCreatedBy")
  approvalSteps   ApprovalStep[]
  approvalFlows   ApprovalFlow[]  @relation("ApprovalRequester")
}

// ==============================
// 案件
// ==============================
model Project {
  id          String        @id @default(cuid())
  projectCode String       @unique // PJ-YYYYMMDD-XXXX
  name        String
  description String?
  status      ProjectStatus @default(IN_PROGRESS)
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  address     String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders   PurchaseOrder[]
  invoices Invoice[]
}

// ==============================
// 発注書
// ==============================
model PurchaseOrder {
  id               String      @id @default(cuid())
  orderNumber      String      @unique // PO-YYYYMMDD-XXXX
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id])
  issuerId         String
  issuer           Company     @relation("OrderIssuer", fields: [issuerId], references: [id])
  receiverId       String
  receiver         Company     @relation("OrderReceiver", fields: [receiverId], references: [id])
  createdById      String
  createdBy        User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  subject          String
  orderType        String?     // 工事/材料/その他
  status           OrderStatus @default(DRAFT)
  subtotal         Float       @default(0)
  taxRate          Float       @default(0.1)
  taxAmount        Float       @default(0)
  totalAmount      Float       @default(0)
  notes            String?
  issuedAt         DateTime?
  deliveryDeadline DateTime?
  // 電子帳簿保存法対応
  confirmedAt      DateTime?   // 確定日時（タイムスタンプ）
  confirmedHash    String?     // 確定時のハッシュ値（改ざん防止）
  // 取引契約 必要記載事項（下請法・請負契約一般）
  constructionName        String?    // 工事名称
  constructionSite        String?    // 工事場所
  constructionPeriodStart DateTime?  // 工期開始
  constructionPeriodEnd   DateTime?  // 工期終了
  paymentTerms            String?    // 支払条件
  defectWarranty          String?    // 瑕疵担保責任
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items        PurchaseOrderItem[]
  approvalFlow ApprovalFlow?
  invoices     Invoice[]
}

// ==============================
// 発注明細
// ==============================
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemOrder       Int
  name            String
  specification   String?
  quantity        Float
  unit            String        // 式, m, m2, m3, kg, 本, 個 等
  unitPrice       Float
  amount          Float
  remarks         String?
}

// ==============================
// 請求書
// ==============================
model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique // INV-YYYYMMDD-XXXX
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  issuerId        String
  issuer          Company        @relation("InvoiceIssuer", fields: [issuerId], references: [id])
  receiverId      String
  receiver        Company        @relation("InvoiceReceiver", fields: [receiverId], references: [id])
  createdById     String
  createdBy       User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  subject         String
  status          InvoiceStatus  @default(DRAFT)
  subtotal        Float          @default(0)
  taxRate         Float          @default(0.1)
  taxAmount       Float          @default(0)
  totalAmount     Float          @default(0)
  dueDate         DateTime?
  notes           String?
  // 電子帳簿保存法対応
  confirmedAt     DateTime?      // 確定日時（タイムスタンプ）
  confirmedHash   String?        // 確定時のハッシュ値（改ざん防止）
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items        InvoiceItem[]
  approvalFlow ApprovalFlow?
}

// ==============================
// 請求明細
// ==============================
model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemOrder     Int
  name          String
  specification String?
  quantity      Float
  unit          String
  unitPrice     Float
  amount        Float
  remarks       String?
}

// ==============================
// 承認フロー
// ==============================
model ApprovalFlow {
  id              String             @id @default(cuid())
  targetType      ApprovalTargetType
  purchaseOrderId String?            @unique
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  invoiceId       String?            @unique
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])
  status          ApprovalStatus     @default(PENDING)
  requestedById   String
  requestedBy     User               @relation("ApprovalRequester", fields: [requestedById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  steps ApprovalStep[]
}

// ==============================
// 承認ステップ
// ==============================
model ApprovalStep {
  id             String         @id @default(cuid())
  approvalFlowId String
  approvalFlow   ApprovalFlow   @relation(fields: [approvalFlowId], references: [id], onDelete: Cascade)
  stepOrder      Int
  approverId     String
  approver       User           @relation(fields: [approverId], references: [id])
  status         ApprovalStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([approvalFlowId, stepOrder])
}

// ==============================
// 取引先招待（電子取引類型：発注側→受注側 無償アカウント発行フロー）
// ==============================
model Invitation {
  id                    String           @id @default(cuid())
  token                 String           @unique // 招待URLに埋め込むトークン
  inviterCompanyId      String           // 発注側企業（招待発行元）
  inviterUserId         String           // 招待発行操作を行ったユーザーID
  inviterUserName       String           // 発行者名（表示用スナップショット）
  invitedCompanyName    String           // 招待先会社名（受諾前のスナップショット）
  invitedContactName    String?          // 招待先担当者名（任意）
  invitedContactEmail   String           // 招待先メールアドレス
  message               String?          // 発注側からのメッセージ（任意）
  status                InvitationStatus @default(PENDING)
  acceptedCompanyId     String?          // 受諾時に作成された Company の ID
  acceptedUserId        String?          // 受諾時に作成された User の ID
  acceptedAt            DateTime?
  revokedAt             DateTime?
  expiresAt             DateTime         // 有効期限（デフォルト 30日後）
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([inviterCompanyId])
  @@index([status])
  @@index([invitedContactEmail])
}

// ==============================
// 監査ログ
// ==============================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  action     String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, LOGOUT
  targetType String   // COMPANY, PROJECT, ORDER, INVOICE, USER
  targetId   String?
  details    String?  // JSON string with additional details
  ipAddress  String?
  createdAt  DateTime @default(now())
}
