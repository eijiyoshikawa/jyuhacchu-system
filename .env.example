# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/jyuhacchu"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jyuhacchu

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Sentry (エラー監視 - https://sentry.io で無料アカウント作成)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# 国税庁 適格請求書発行事業者公表システム Web-API
# https://www.invoice-kohyo.nta.go.jp/web-api/ でアプリケーションIDを取得
# 未設定の場合はフォーマットチェック（T+13桁）のみ実行
NTA_APP_ID=
